(defvar chief/lean-unicode-input--abbrev-table nil
  "Hash table mapping Lean abbreviation names to Unicode strings.")

(defvar chief/lean-unicode-input--prefix-table nil
  "Hash table of proper prefixes of Lean Unicode abbreviation names.")

(defvar-local chief/lean-unicode-input-mode nil
  "Non-nil when Lean Unicode abbreviation input is enabled.")

(defun chief/lean-unicode-input--ensure-tables ()
  "Build Lean Unicode abbreviation lookup tables if needed."
  (unless (and (hash-table-p chief/lean-unicode-input--abbrev-table)
               (hash-table-p chief/lean-unicode-input--prefix-table))
    (setq chief/lean-unicode-input--abbrev-table (make-hash-table :test #'equal)
          chief/lean-unicode-input--prefix-table (make-hash-table :test #'equal))
    (dolist (entry chief/lean-unicode-input-abbreviations)
      (let ((abbr (car entry))
            (symbol (cdr entry)))
        (puthash abbr symbol chief/lean-unicode-input--abbrev-table)
        (dotimes (i (max 0 (1- (length abbr))))
          (puthash (substring abbr 0 (1+ i)) t
                   chief/lean-unicode-input--prefix-table))))))

(defun chief/lean-unicode-input--lookup (abbr)
  "Return the Unicode expansion for ABBR, or nil."
  (chief/lean-unicode-input--ensure-tables)
  (gethash abbr chief/lean-unicode-input--abbrev-table))

(defun chief/lean-unicode-input--proper-prefix-p (abbr)
  "Return non-nil when ABBR is a proper prefix of another abbreviation."
  (chief/lean-unicode-input--ensure-tables)
  (gethash abbr chief/lean-unicode-input--prefix-table))

(defun chief/lean-unicode-input--leader-start (&optional end)
  "Return start position of the abbreviation leader before END on this line."
  (let ((end (or end (point)))
        (leader chief/lean-unicode-input-leader)
        start)
    (when (and (stringp leader) (not (string-empty-p leader)))
      (save-excursion
        (goto-char end)
        (setq start (search-backward leader (line-beginning-position) t)))
      (when (and start
                 ;; Avoid treating an old backslash far to the left as an
                 ;; active abbreviation after the user has typed ordinary text.
                 (<= (- end start) 80))
        start))))

(defun chief/lean-unicode-input--insert-symbol (symbol)
  "Insert SYMBOL, respecting the official `$CURSOR' marker if present."
  (let ((cursor (string-match (regexp-quote "$CURSOR") symbol)))
    (if cursor
        (let ((before (substring symbol 0 cursor))
              (after (substring symbol (+ cursor (length "$CURSOR")))))
          (insert before)
          (let ((point (point)))
            (insert after)
            (goto-char point)))
      (insert symbol))))

(defun chief/lean-unicode-input--replace (start end symbol)
  "Replace region START..END with SYMBOL and return t."
  (delete-region start end)
  (chief/lean-unicode-input--insert-symbol symbol)
  t)

(defun chief/lean-unicode-input--delimiter-p (char)
  "Return non-nil when CHAR should finish a Lean abbreviation."
  (or (null char)
      (memq char '(?\n ?\r ?\t ?\s ?\) ?\] ?\} ?\, ?\. ?\; ?\:))))

(defun chief/lean-unicode-input-try-convert (&optional force choose)
  "Try to convert the Lean Unicode abbreviation before point.
When FORCE is nil, only convert automatically when the abbreviation is complete
and unambiguous, or when a delimiter was just typed after a complete
abbreviation.  When CHOOSE is non-nil, offer completion for prefix matches.
Return non-nil if a conversion happened."
  (interactive (list t t))
  (chief/lean-unicode-input--ensure-tables)
  (let* ((end (point))
         (leader-start (chief/lean-unicode-input--leader-start end))
         (leader-len (length chief/lean-unicode-input-leader))
         (last-char (and (> end (point-min)) (char-before end)))
         (converted nil))
    (when leader-start
      (let* ((abbr-start (+ leader-start leader-len))
             (abbr (buffer-substring-no-properties abbr-start end))
             (symbol (chief/lean-unicode-input--lookup abbr)))
        (cond
         ((and symbol
               (or force
                   (not (chief/lean-unicode-input--proper-prefix-p abbr))
                   ;; Official abbreviations such as `+ ' intentionally end in
                   ;; a space, so include that space in the replacement.
                   (string-suffix-p " " abbr)))
          (setq converted
                (chief/lean-unicode-input--replace leader-start end symbol)))
         ((and (not force)
               (chief/lean-unicode-input--delimiter-p last-char)
               (> end abbr-start))
          ;; A delimiter after a complete abbreviation finishes it, but the
          ;; delimiter itself should stay in the buffer.  This makes `\\and '
          ;; become `∧ ', even though `and' is a prefix of `and='.
          (let* ((abbr-end (1- end))
                 (delimiter-len (- end abbr-end))
                 (abbr2 (buffer-substring-no-properties abbr-start abbr-end))
                 (symbol2 (chief/lean-unicode-input--lookup abbr2)))
            (when symbol2
              (delete-region leader-start abbr-end)
              (goto-char leader-start)
              (chief/lean-unicode-input--insert-symbol symbol2)
              (forward-char delimiter-len)
              (setq converted t))))
         ((and force choose)
          (let* ((prefix abbr)
                 (matches (cl-loop for (key . value)
                                   in chief/lean-unicode-input-abbreviations
                                   when (string-prefix-p prefix key)
                                   collect (cons key value))))
            (cond
             ((null matches)
              (user-error "No Lean Unicode abbreviation matches \\%s" prefix))
             ((= (length matches) 1)
              (setq converted
                    (chief/lean-unicode-input--replace
                     leader-start end (cdar matches))))
             (t
              (let* ((completion-extra-properties
                      `(:annotation-function
                        ,(lambda (candidate)
                           (format "  %s" (cdr (assoc candidate matches))))))
                     (choice (completing-read
                              "Lean abbreviation: "
                              (mapcar #'car matches) nil t prefix)))
                (setq converted
                      (chief/lean-unicode-input--replace
                       leader-start end (cdr (assoc choice matches))))))))))))
    converted))

(defun chief/lean-unicode-input--post-self-insert ()
  "Convert Lean Unicode abbreviation after ordinary insertion when appropriate."
  (when (and chief/lean-unicode-input-mode
             (characterp last-command-event))
    (ignore-errors
      (chief/lean-unicode-input-try-convert))))

(defun chief/lean-unicode-input-convert-or-indent ()
  "Convert a Lean abbreviation before point, or indent when none is active."
  (interactive)
  (condition-case nil
      (unless (chief/lean-unicode-input-try-convert t t)
        (indent-for-tab-command))
    (user-error
     (indent-for-tab-command))))

(defun chief/lean-insert-unicode-symbol (abbr)
  "Insert a Lean Unicode symbol selected by abbreviation ABBR."
  (interactive
   (progn
     (chief/lean-unicode-input--ensure-tables)
     (let ((completion-extra-properties
            `(:annotation-function
              ,(lambda (candidate)
                 (format "  %s"
                         (cdr (assoc candidate
                                     chief/lean-unicode-input-abbreviations)))))))
       (list (completing-read
              "Lean symbol abbreviation: "
              (mapcar #'car chief/lean-unicode-input-abbreviations)
              nil t)))))
  (chief/lean-unicode-input--insert-symbol
   (or (chief/lean-unicode-input--lookup abbr)
       (user-error "Unknown Lean Unicode abbreviation: %s" abbr))))

(defun chief/lean-show-unicode-abbreviations-for-symbol (symbol)
  "Show Lean Unicode abbreviations that produce SYMBOL."
  (interactive
   (list (if (use-region-p)
             (buffer-substring-no-properties (region-beginning) (region-end))
           (string (or (char-after) (user-error "No symbol at point"))))))
  (let ((matches (cl-loop for (abbr . value) in chief/lean-unicode-input-abbreviations
                          when (equal value symbol)
                          collect (concat chief/lean-unicode-input-leader abbr))))
    (if matches
        (message "%s" (string-join matches ", "))
      (message "No Lean abbreviation found for %s" symbol))))

(defvar chief/lean-unicode-input-mode-map
  (let ((map (make-sparse-keymap)))
    (define-key map (kbd "TAB") #'chief/lean-unicode-input-convert-or-indent)
    (define-key map (kbd "<tab>") #'chief/lean-unicode-input-convert-or-indent)
    map)
  "Keymap for `chief/lean-unicode-input-mode'.")

;;;###autoload
(define-minor-mode chief/lean-unicode-input-mode
  "Automatically convert Lean backslash Unicode abbreviations.
Examples: `\\forall' → `∀', `\\and ' → `∧ ', `\\R' → `ℝ', `\\to' → `→'.
This mode uses the official Lean 4 VS Code abbreviation table and does not
depend on `lean4-mode'."
  :lighter " λ"
  :keymap chief/lean-unicode-input-mode-map
  (if chief/lean-unicode-input-mode
      (add-hook 'post-self-insert-hook
                #'chief/lean-unicode-input--post-self-insert nil t)
    (remove-hook 'post-self-insert-hook
                 #'chief/lean-unicode-input--post-self-insert t)))

(provide 'lang-lean-input)
