;;; core-terminal-keyboard-test.el --- Terminal input regression tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'core-terminal)
(require 'core-evil)

(defmacro chief/with-option-key-fixture (&rest body)
  "Exercise native-layout data without depending on the test host's layout."
  (declare (indent 0) (debug t))
  `(let ((key-translation-map (make-sparse-keymap))
         (chief/tty-option-as-meta t)
         (chief/tty-option-layout nil)
         (chief/tty-option-translations nil)
         (current-input-method nil))
     (cl-letf (((symbol-function 'chief/tty-read-option-layout)
                (lambda ()
                  '((layout . "fixture-Canadian")
                    (keys . ((8776 120) (731 88) (402 102) (8747 98)))))))
       (chief/tty-refresh-option-translations)
       ,@body)))

(ert-deftest chief/terminal-option-M-x-decodes-character-input-in-evil-states ()
  "The received approximately character, not an injected Meta event, must work."
  (chief/with-option-key-fixture
    (with-temp-buffer
      (insert "Input test\n")
      (goto-char (point-min))
      (evil-local-mode 1)
      (dolist (state '(normal insert visual motion emacs))
        (evil-change-state state)
        (let* ((unread-command-events (list ?≈))
               (keys (read-key-sequence nil)))
          (ert-info ((format "Evil state: %s" state))
            (should (equal (key-description keys) "M-x"))
            (should (eq (key-binding keys) 'execute-extended-command))))))))

(ert-deftest chief/terminal-option-shift-and-other-meta-keys ()
  (chief/with-option-key-fixture
    (dolist (case '((?≈ . "M-x") (?˛ . "M-X") (?ƒ . "M-f") (?∫ . "M-b")))
      (should (equal (key-description
                      (funcall (lookup-key key-translation-map (vector (car case)))))
                     (cdr case))))))

(ert-deftest chief/terminal-option-preserves-gui-input ()
  (chief/with-option-key-fixture
    (cl-letf (((symbol-function 'chief/terminal-frame-p) (lambda (&optional _) nil)))
      (should (equal (funcall (lookup-key key-translation-map "≈")) [?≈])))))

(ert-deftest chief/terminal-option-preserves-input-methods-and-can-be-disabled ()
  (chief/with-option-key-fixture
    (let ((current-input-method "test-input-method"))
      (should (equal (funcall (lookup-key key-translation-map "≈")) [?≈])))
    (let ((chief/tty-option-as-meta nil))
      (should (equal (funcall (lookup-key key-translation-map "≈")) [?≈])))))

(ert-deftest chief/terminal-option-refresh-preserves-user-translations ()
  (chief/with-option-key-fixture
    (define-key key-translation-map "≈" [f24])
    (chief/tty-refresh-option-translations)
    (should (equal (lookup-key key-translation-map "≈") [f24]))
    (chief/tty-reset-option-translations)
    (should (equal (lookup-key key-translation-map "≈") [f24]))
    (should-not (lookup-key key-translation-map "ƒ"))
    (should-not chief/tty-option-layout)))

(ert-deftest chief/terminal-option-rejects-invalid-data-before-changing-bindings ()
  (chief/with-option-key-fixture
    (let ((translation (lookup-key key-translation-map "≈")))
      (cl-letf (((symbol-function 'chief/tty-read-option-layout)
                 (lambda () '((layout . "invalid") (keys . ((8776 "x")))))))
        (should-error (chief/tty-refresh-option-translations)))
      (should (eq translation (lookup-key key-translation-map "≈"))))))

(ert-deftest chief/terminal-control-space-preserves-command-and-insert-states ()
  (with-temp-buffer
    (insert "Input test\n")
    (goto-char (point-min))
    (evil-local-mode 1)
    (dolist (state '(normal visual motion emacs))
      (evil-change-state state)
      (should (equal (chief/tty-decode-control-space) (kbd "C-SPC"))))
    (evil-insert-state)
    (should (equal (chief/tty-decode-control-space) [0]))
    (should (eq (key-binding (kbd "C-@")) 'completion-at-point))))

(ert-deftest chief/terminal-legacy-meta-timeout-allows-split-input ()
  (should (>= evil-esc-delay 0.1)))

(ert-deftest chief/terminal-extended-decoder-and-quit-safety-are-configured ()
  (should (featurep 'kkp))
  (should kkp-restore-legacy-keys-around-subprocesses)
  (should (advice-member-p #'chief/tty-enable-extended-keys 'kkp-enable-in-terminal))
  (when noninteractive
    (should-not global-kkp-mode))
  (dolist (case '(("120;3u" . "M-x") ("46;5u" . "C-.")
                  ("59;5u" . "C-;") ("32;6u" . "C-S-SPC")))
    (should (equal (key-description
                    (kkp--translate-terminal-input (string-to-list (car case))))
                   (cdr case)))))

(ert-deftest chief/terminal-protocol-starts-without-waiting-for-a-keypress ()
  (let ((native-comp-enable-subr-trampolines nil)
        (noninteractive nil)
        (global-kkp-mode t)
        (input-decode-map (make-sparse-keymap))
        (queued t)
        pending callback enabled)
    (define-key input-decode-map "\e[?" #'ignore)
    (cl-letf (((symbol-function 'terminal-live-p) (lambda (_) t))
              ((symbol-function 'display-graphic-p) (lambda (&optional _) nil))
              ((symbol-function 'frame-terminal) (lambda (&optional _) 'test-tty))
              ((symbol-function 'terminal-parameter) (lambda (&rest _) pending))
              ((symbol-function 'set-terminal-parameter)
               (lambda (_terminal _key value) (setq pending value)))
              ((symbol-function 'input-pending-p) (lambda (&optional _) queued))
              ((symbol-function 'run-with-idle-timer)
               (lambda (&rest _) (ert-fail "Protocol setup must not require an idle cycle")))
              ((symbol-function 'run-at-time)
               (lambda (delay repeat function)
                 (should (= delay 0.1))
                 (should-not repeat)
                 (setq callback function)
                 'scheduled)))
      (chief/tty-enable-extended-keys
       (lambda (terminal) (setq enabled terminal)) 'test-tty)
      (should callback)
      (should-not enabled)
      ;; Busy startup may outlast the device-response timeout.
      (dotimes (_ 25) (funcall callback))
      (should pending)
      (should-not enabled)
      (setq queued nil)
      (funcall callback)
      (should-not enabled)
      ;; Native device replies have now been handled by the input loop.
      (define-key input-decode-map "\e[?" nil)
      (funcall callback)
      (should-not pending)
      (should (eq enabled 'test-tty)))))

(ert-deftest chief/terminal-native-layout-uses-a-cached-module-not-a-process ()
  (skip-unless (eq system-type 'darwin))
  (chief/tty-load-option-module)
  (should (featurep 'chief-macos-option-keys))
  (should (eq (type-of (symbol-function 'chief--macos-option-layout)) 'module-function))
  (let ((native-comp-enable-subr-trampolines nil))
    (cl-letf (((symbol-function 'call-process)
               (lambda (&rest _) (ert-fail "Cached layout queries must not start processes")))
              ((symbol-function 'chief/tty-build-option-module)
               (lambda (&rest _) (ert-fail "A cached module must not be rebuilt"))))
      (should (stringp (alist-get 'layout (chief/tty-read-option-layout))))))
  (should-error (chief--macos-option-layout t) :type 'wrong-number-of-arguments))

(ert-deftest chief/terminal-native-layout-values-survive-garbage-collection ()
  (skip-unless (eq system-type 'darwin))
  (let ((expected (chief/tty-read-option-layout))
        (gc-cons-threshold 4096)
        (gc-cons-percentage 0.0))
    (dotimes (_ 10)
      (garbage-collect)
      (should (equal expected (chief/tty-read-option-layout))))))

(ert-deftest chief/terminal-native-build-failure-preserves-cache-and-cleans-tempfiles ()
  (let* ((native-comp-enable-subr-trampolines nil)
         (system-configuration "aarch64-apple-darwin")
         (module-file-suffix ".dylib")
         (directory (make-temp-file "emacs-option-build-test-" t))
         (destination (expand-file-name "module.dylib" directory))
         compiler-called)
    (unwind-protect
        (progn
          (with-temp-file destination (insert "previous module"))
          (cl-letf (((symbol-function 'chief/tty-option-module-header)
                     (lambda () "/fixture/include/emacs-module.h"))
                    ((symbol-function 'file-executable-p)
                     (lambda (program)
                       (member program (list "/usr/bin/xcode-select" "/usr/bin/xcrun"
                                             (expand-file-name "usr/bin/clang" directory)))))
                    ((symbol-function 'call-process)
                     (lambda (program &rest _)
                       (if (equal program "/usr/bin/xcode-select")
                           (progn (insert directory) 0)
                         (setq compiler-called t)
                         (insert "intentional compiler failure")
                         1))))
            (should-error (chief/tty-build-option-module "/fixture/module.c" destination)))
          (should compiler-called)
          (should (equal (with-temp-buffer
                           (insert-file-contents destination)
                           (buffer-string))
                         "previous module"))
          (should-not (directory-files directory nil "\\`\\.option-module-")))
      (delete-directory directory t))))

(ert-deftest chief/terminal-native-layout-query-is-read-only-and-valid ()
  (skip-unless (eq system-type 'darwin))
  (let ((data (chief/tty-read-option-layout)))
    (should (stringp (alist-get 'layout data)))
    (should (listp (alist-get 'keys data)))
    (dolist (pair (alist-get 'keys data))
      (should (= (length pair) 2))
      (should (characterp (nth 0 pair)))
      (should (<= 32 (nth 1 pair) 126)))))

(provide 'core-terminal-keyboard-test)
