;;; vercel-theme-support.el --- Vercel theme face mappings -*- lexical-binding: t; -*-

;; Vercel-specific palette role choices and face mappings.  The generic
;; `chief-theme-kit.el' deliberately contains no theme policy; this file owns the
;; decisions that make the local themes look like the Zed Vercel theme.

(eval-and-compile
  (unless (fboundp 'chief-theme-kit-color)
    (let* ((support-file (or load-file-name buffer-file-name))
           (support-directory (and support-file (file-name-directory support-file)))
           (candidates (delq nil
                             (list (and support-directory
                                        (expand-file-name "chief-theme-kit.el" support-directory))
                                   (expand-file-name "chief-theme-kit.el" default-directory)
                                   (expand-file-name "themes/chief-theme-kit.el" default-directory))))
           (kit-file (catch 'found
                       (dolist (candidate candidates)
                         (when (file-readable-p candidate)
                           (throw 'found candidate))))))
      (unless kit-file
        (error "Unable to locate chief-theme-kit.el for vercel-theme-support"))
      (load kit-file nil t))))

(declare-function chief-theme-kit-apply "chief-theme-kit" (theme faces &optional variables))

