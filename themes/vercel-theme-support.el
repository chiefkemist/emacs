(defun vercel-theme--variables (palette)
  "Return Vercel custom variable specs derived from PALETTE."
  (chief-theme-kit-with-colors palette
      (black red green yellow blue magenta cyan bright-white)
    `((ansi-color-names-vector [,black ,red ,green ,yellow ,blue ,magenta ,cyan ,bright-white]))))

(defun vercel-theme-apply (theme palette)
  "Apply Vercel face and variable specs for THEME from PALETTE."
  (chief-theme-kit-apply theme
                         (vercel-theme--faces palette)
                         (vercel-theme--variables palette)))

(provide 'vercel-theme-support)

